#!/bin/sh
# Keep the gateway's logs bounded: its own log on the 64 MB /var/log tmpfs,
# and the dashboard log on /data. When a log passes 8 MB, keep its last 2 MB. The file is truncated in place so
# the writer keeps its handle; the dashboard notices and rereads it.
for f in /var/log/m17-gateway/m17-gateway.log /data/log/m17-gateway/dashboard.log; do
	[ -f "$f" ] || continue
	size=$(stat -c %s "$f")
	[ "$size" -gt 8388608 ] || continue
	tail -c 2097152 "$f" | sed '1d' > "$f.tmp" && cat "$f.tmp" > "$f"
	rm -f "$f.tmp"
done
