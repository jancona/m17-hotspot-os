#!/bin/sh
# systemctl - minimal stand-in for the few systemctl commands rpi-dashboard
# runs, so the dashboard works unchanged on OpenRC.
# Part of m17-hotspot-os.
#
#   systemctl start|stop|restart|status m17-gateway[.service]
#   systemctl reboot|poweroff
#
# Anything else fails. Privileged actions go through doas to
# /usr/local/libexec/m17os/service-control, which www-data may run.

CONTROL=/usr/local/libexec/m17os/service-control

run() {
	if [ "$(id -u)" -eq 0 ]; then
		exec "$CONTROL" "$@"
	fi
	exec doas -n "$CONTROL" "$@"
}

action="$1"
unit="${2%.service}"

case "$action" in
	start|stop|restart|status)
		[ "$unit" = "m17-gateway" ] || { echo "systemctl: unit '$2' is not supported here" >&2; exit 1; }
		run "$action" "$unit"
		;;
	is-active)
		[ "$unit" = "m17-gateway" ] || exit 3
		rc-service m17-gateway status >/dev/null 2>&1 && { echo active; exit 0; }
		echo inactive
		exit 3
		;;
	reboot|poweroff)
		run "$action"
		;;
	*)
		echo "systemctl: '$action' is not supported on m17-hotspot-os (OpenRC); use rc-service" >&2
		exit 1
		;;
esac
